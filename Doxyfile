# Doxyfile for woad (C API)

PROJECT_NAME           = "woad"
PROJECT_BRIEF          = "Minimal ANSI terminal colour codes, for C (and C++)"
PROJECT_NUMBER         = 0.2.0

# Prefer SIS_CMAKE_BUILD_DIR-aligned output (same convention as BDUT /
# CLASP / cstring / Diagnosticism). ./dox/ remains gitignored for
# legacy/local runs that override OUTPUT_DIRECTORY.
OUTPUT_DIRECTORY       = _build/doxygen
CREATE_SUBDIRS         = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
TIMESTAMP              = NO

INPUT                  = include/woad \
                         doc
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.md
RECURSIVE              = NO
# iostreams.hpp does not yet parse and is not a stable API. Drop this
# exclusion when that header is finished and documented.
EXCLUDE                = include/woad/iostreams.hpp

USE_MDFILE_AS_MAINPAGE = doc/mainpage.md

EXAMPLE_PATH           = examples
EXAMPLE_RECURSIVE      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES

WARN_AS_ERROR          = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
# Hide per-header edit macros and the legacy version aliases. Strip the
# linkage wrapper so prototypes read as the return type alone. Defining
# the skip section also keeps the Windows-only prototypes visible.
PREDEFINED             = WOAD_DOCUMENTATION_SKIP_SECTION \
                         WOAD_CALL(rt)=rt

HAVE_DOT               = NO


